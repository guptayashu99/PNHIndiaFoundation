---
import { site } from '../site';
import { url, isActive } from '../lib/url';
import Logo from './Logo.astro';

const current = Astro.url.pathname;

const navLinks = [
  { label: 'About PNH', href: '/about-pnh' },
  { label: 'Patient Support', href: '/patient-support' },
  { label: 'Resources', href: '/resources' },
  { label: 'What We Do', href: '/what-we-do' },
  { label: 'About Us', href: '/about-us' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href={url('/')} class="brand" aria-label={`${site.name} — home`}>
      <Logo />
      <span class="brand-text">
        <span class="brand-name">PNH India Foundation</span>
        <span class="brand-sub">Patient advocacy &amp; support</span>
      </span>
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="visually-hidden">Menu</span>
      <span class="nav-toggle-bars" aria-hidden="true"></span>
    </button>

    <nav id="primary-nav" class="nav" aria-label="Primary">
      <ul class="nav-list">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={url(link.href)}
                aria-current={isActive(current, link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="nav-cta">
          <a href={url('/support-us')} class="btn btn--primary">Support Us</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--text);
    padding-block: 0.6rem;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand-name {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .brand-sub {
    font-size: 0.76rem;
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }

  .nav-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
  }

  .nav-list a:not(.btn) {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0.5rem 0.8rem;
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 550;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav-list a:not(.btn):hover {
    color: var(--brand-strong);
    background: var(--bg-brand-soft);
  }

  .nav-list a[aria-current='page'] {
    color: var(--brand);
    font-weight: 700;
    background: var(--bg-brand-soft);
  }

  .nav-cta { margin-left: 0.5rem; }
  .nav-cta .btn { padding: 0.55rem 1.05rem; font-size: 0.95rem; }

  .nav-toggle {
    display: none;
    background: transparent;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius);
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0.6rem 0.7rem;
    cursor: pointer;
    color: var(--brand);
  }
  .nav-toggle:hover {
    border-color: var(--brand);
    background: var(--bg-brand-soft);
  }

  .nav-toggle-bars,
  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
  }
  .nav-toggle-bars { position: relative; }
  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .nav-toggle-bars::before { top: -6px; }
  .nav-toggle-bars::after { top: 6px; }

  /* Collapse to a disclosure menu before the six nav links start to crowd. */
  @media (max-width: 70rem) {
    .nav-toggle { display: block; }

    .nav {
      display: none;
      flex-basis: 100%;
      border-top: 1px solid var(--border);
      padding-block: 0.5rem 1rem;
    }
    .nav[data-open='true'] { display: block; }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0.1rem;
    }
    .nav-list a:not(.btn) {
      padding: 0.75rem 0.6rem;
      font-size: 1rem;
    }
    .nav-cta {
      margin: 0.6rem 0 0;
    }
    .nav-cta .btn { width: 100%; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.setAttribute('data-open', String(!open));
  });
</script>
