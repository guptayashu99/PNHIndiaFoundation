---
import { sources } from '../data/sources';

interface Props {
  /** Restrict to specific source ids; omit to list all. */
  ids?: string[];
  heading?: string;
}

const { ids, heading = 'Sources' } = Astro.props;
const list = ids ? sources.filter((s) => ids.includes(s.id)) : sources;
---

<section class="sources">
  <h2>{heading}</h2>
  <p class="sources-intro">
    Clinical and policy statements on this page are drawn from the references
    below. Each shows the date we last checked it — medical guidance and
    government policy both change, and a citation without a date is not much of a
    citation.
  </p>
  <ol>
    {
      list.map((s) => (
        <li>
          <a href={s.url} rel="noopener">
            {s.title}
          </a>
          <span class="publisher">{s.publisher}</span>
          {s.note && <span class="note">{s.note}</span>}
          <span class="checked">Last checked {s.checked}</span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .sources {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
    margin-top: 3rem;
  }

  .sources h2 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .sources-intro {
    font-size: 0.92rem;
    color: var(--text-muted);
    max-width: 62ch;
  }

  .sources ol {
    padding-left: 1.3em;
    margin-top: 1.25rem;
  }

  .sources li {
    margin-bottom: 1rem;
    font-size: 0.92rem;
  }

  .sources a { font-weight: 550; }

  .publisher,
  .note,
  .checked {
    display: block;
    color: var(--text-muted);
  }

  .note { font-size: 0.88rem; margin-top: 0.15rem; }

  .checked {
    font-size: 0.82rem;
    margin-top: 0.15rem;
    opacity: 0.85;
  }
</style>
