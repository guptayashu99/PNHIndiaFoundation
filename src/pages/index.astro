---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { site } from '../site';
---

<Base title="Home" isHome={true}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <span class="eyebrow">Paroxysmal Nocturnal Haemoglobinuria</span>
        <h1>No one should face PNH alone.</h1>
        <p class="lede">
          PNH India Foundation is a patient-led advocacy organisation working
          alongside people living with Paroxysmal Nocturnal Haemoglobinuria
          across India — and the families who care for them.
        </p>
        <div class="btn-row">
          <a href={url('/patient-support')} class="btn btn--primary">
            Newly diagnosed? Start here
          </a>
          <a href={url('/about-pnh')} class="btn btn--secondary">What is PNH?</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Immediate reassurance for the most vulnerable visitor -->
  <section class="section section--tight">
    <div class="container">
      <div class="callout">
        <h3>Just been diagnosed?</h3>
        <p>
          Being told you have a disease you have never heard of is frightening.
          Three things are worth knowing right now: PNH is
          <strong>not cancer</strong>, it is <strong>not contagious</strong>,
          and it is <strong>not inherited</strong> — you did not pass it on and
          you did not catch it. It is also <strong>treatable</strong>, and
          treatment has improved enormously over the last two decades.
        </p>
        <p>
          <a href={url('/patient-support')}>Read our guide for newly diagnosed patients →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- What we do -->
  <section class="section section--muted">
    <div class="container">
      <span class="eyebrow">What we do</span>
      <h2>Four things we focus on</h2>
      <p class="lede">
        PNH is rare enough that patients often know more about it than the first
        doctor they meet. We work to close that gap.
      </p>

      <div class="grid grid--2" style="margin-top: 2.5rem;">
        <div class="card">
          <h3>Information you can trust</h3>
          <p>
            Plain-language explanations of what PNH is, how it is diagnosed, and
            what the treatment options are — written for patients and families,
            not for clinicians.
          </p>
        </div>
        <div class="card">
          <h3>Peer support</h3>
          <p>
            Connecting patients and caregivers with others who have been through
            the same thing. The single most common thing we hear is: "I thought I
            was the only one in India."
          </p>
        </div>
        <div class="card">
          <h3>Access to treatment</h3>
          <p>
            Helping patients navigate the practical reality of getting treated —
            finding a haematologist experienced with PNH, understanding
            government rare disease schemes, and dealing with the cost of care.
          </p>
        </div>
        <div class="card">
          <h3>Awareness and advocacy</h3>
          <p>
            Raising awareness among clinicians so PNH is recognised sooner, and
            representing patients' interests in policy conversations about rare
            disease care in India.
          </p>
        </div>
      </div>

      <div class="btn-row">
        <a href={url('/what-we-do')} class="btn btn--secondary">More about our work</a>
      </div>
    </div>
  </section>

  <!-- PNH in brief -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="prose">
          <span class="eyebrow">In brief</span>
          <h2>What is PNH?</h2>
          <p>
            Paroxysmal Nocturnal Haemoglobinuria is a rare, acquired blood
            disorder. A change in some of the blood-forming stem cells in the
            bone marrow leaves the red blood cells they produce without their
            normal protective coating. Part of the immune system — called the
            complement system — then destroys those red cells.
          </p>
          <p>
            That destruction is what causes the main problems: persistent
            fatigue, anaemia, dark-coloured urine, and a raised risk of
            dangerous blood clots. Symptoms vary enormously from person to
            person, which is one reason diagnosis is so often delayed.
          </p>
          <p>
            <a href={url('/about-pnh')}>Read the full explanation →</a>
          </p>
        </div>

        <ul class="facts">
          <li>
            <span class="fact-label">Rarity</span>
            <span class="fact-value">~1–2 per million</span>
            <span class="fact-note">
              new diagnoses per million people each year, and reported more often
              across Asia than in the West. Most doctors will never see a case.
            </span>
          </li>
          <li>
            <span class="fact-label">Typical onset</span>
            <span class="fact-value">In your thirties</span>
            <span class="fact-note">
              The median age of onset, though PNH occurs at any age and affects
              men and women about equally.
            </span>
          </li>
          <li>
            <span class="fact-label">The misleading name</span>
            <span class="fact-value">Only ~30% see dark urine</span>
            <span class="fact-note">
              Most patients never have the symptom PNH is named after — a major
              reason the diagnosis gets missed for years.
            </span>
          </li>
          <li>
            <span class="fact-label">Diagnosis</span>
            <span class="fact-value">A blood test</span>
            <span class="fact-note">
              High-sensitivity flow cytometry confirms PNH — no bone marrow
              biopsy is needed for the diagnosis itself.
            </span>
          </li>
          <li>
            <span class="fact-label">Treatment in India</span>
            <span class="fact-value">Approved since 2025</span>
            <span class="fact-note">
              Eculizumab became the first anti-complement therapy approved in
              India in January 2025. Affording it remains the real barrier.
            </span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- The headline advocacy issue -->
  <section class="section section--muted">
    <div class="container">
      <div class="campaign">
        <div class="prose">
          <span class="eyebrow">What we're campaigning for</span>
          <h2>PNH is missing from India's rare disease policy</h2>
          <p>
            The National Policy for Rare Diseases, 2021 offers up to
            <strong>₹50 lakh per patient</strong> for treatment at a designated
            Centre of Excellence. It names 63 rare diseases.
            <strong>PNH is not one of them.</strong>
          </p>
          <p>
            This is not a minor omission. PNH is rare, it has a definitive
            treatment, and that treatment is lifelong and expensive — precisely
            the profile the policy was written to cover. Eculizumab has been
            approved in India since January 2025, but approval without funding
            leaves most families exactly where they were.
          </p>
          <p>
            Getting PNH recognised under the NPRD is the single change that would
            do most for patients in this country.
          </p>
          <div class="btn-row">
            <a href={url('/about-pnh#pnh-in-india')} class="btn btn--secondary">
              Read the detail
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Support CTA -->
  <section class="section section--brand-soft">
    <div class="container cta-band">
      <div>
        <h2>Help us reach the patients we haven't found yet</h2>
        <p class="lede">
          There are people living with undiagnosed or unsupported PNH in India
          right now. Whether you are a patient, a caregiver, a clinician or a
          supporter, there is a way for you to help.
        </p>
      </div>
      <div class="btn-row cta-actions">
        <a href={url('/support-us')} class="btn btn--primary">Get involved</a>
        <a href={`mailto:${site.email}`} class="btn btn--secondary">Email us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Soft out-of-focus discs echoing red blood cells under a microscope.
     Kept very low contrast — it should register as warmth and texture, not as
     a picture of the thing that is going wrong in the reader's body. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(180deg, var(--bg-brand-soft) 0%, var(--bg) 100%);
    padding-block: clamp(3rem, 9vw, 6.5rem);
    border-bottom: 1px solid var(--border);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      radial-gradient(circle at 82% 18%, transparent 38px, var(--crimson-100) 39px, var(--crimson-100) 62px, transparent 63px),
      radial-gradient(circle at 94% 62%, transparent 24px, var(--crimson-100) 25px, var(--crimson-100) 40px, transparent 41px),
      radial-gradient(circle at 68% 86%, transparent 18px, var(--crimson-100) 19px, var(--crimson-100) 30px, transparent 31px);
    opacity: 0.75;
    pointer-events: none;
  }

  @media (prefers-color-scheme: dark) {
    .hero::before { opacity: 0.18; }
  }

  /* The motif sits behind the text column on narrow screens, so drop it. */
  @media (max-width: 48rem) {
    .hero::before { display: none; }
  }

  .hero-content { max-width: 42rem; position: relative; }
  .hero h1 { margin-bottom: 0.45em; }

  .split {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  @media (min-width: 58rem) {
    .split { grid-template-columns: 1.15fr 1fr; }
  }

  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .facts li {
    background: var(--surface);
    padding: 1.15rem 1.3rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .fact-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .fact-value {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--brand);
    line-height: 1.3;
  }

  .fact-note {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .campaign {
    border-left: 5px solid var(--accent);
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: var(--shadow-sm);
  }
  .campaign .prose > :last-child { margin-bottom: 0; }
  .campaign .btn-row { margin-bottom: 0; }

  .cta-band {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 55rem) {
    .cta-band { grid-template-columns: 1.6fr auto; }
    .cta-actions { margin-top: 0; }
  }
</style>
